# Copy to .env and fill in. .env is gitignored.
# JWT_SECRET must be at least 32 characters.

JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_API_KEY=
MONGODB_URI=

# Object storage for call audio and archived transcripts (Cloudflare R2).
# Leave R2_ENABLED=false and the rest blank: the CRM still records calls and
# transcripts in Mongo, it just has no archive to point at.
R2_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
